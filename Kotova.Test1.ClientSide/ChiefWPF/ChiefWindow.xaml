<Window x:Class="Kotova.Test1.ClientSide.ChiefWPF.ChiefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kotova.Test1.ClientSide.ChiefWPF"
        mc:Ignorable="d"
        Title="ChiefOfDepartment" Height="845" Width="1102"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Nordic Color Palette Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#81A1C1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#EBCB8B"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#BF616A"/>
        </Style>

        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#ECEFF4"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#ECEFF4"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E9F0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#ECEFF4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="TreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#5E81AC" BorderBrush="#4C566A" BorderThickness="0,0,0,2">
            <Grid Height="60" Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👔" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Руководитель отдела" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="label10_Wpf" Text="Вы вошли как:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="usernameLabel_Wpf" Text="[Имя пользователя]" FontWeight="Bold" VerticalAlignment="Center" Foreground="#EBCB8B" FontSize="14"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Button x:Name="testButton_Wpf" Grid.Column="1" Content="🧪 Test" 
                        Style="{StaticResource ActionButtonStyle}" 
                        ToolTip="Тестовая функция"/>

                <!-- Exit Button -->
                <Button x:Name="LogOutButton_Wpf" Grid.Column="2" Content="🚪 Выйти" 
                        Style="{StaticResource DangerButtonStyle}" 
                        ToolTip="Выйти из учётной записи"/>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="ChiefTabControl_Wpf" Grid.Row="1" Margin="12,10,12,10" Background="#F8F9FA" BorderThickness="0">

            <!-- Tab 1: Создание инструктажей -->
            <TabItem Header="📝 Создание инструктажа" Style="{StaticResource TabItemStyle}">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left Column: Controls and People -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,20,0">
                        <!-- Instruction Type -->
                        <TextBlock x:Name="label2_Wpf" Text="📋 Тип инструктажа:" 
                                  Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                        <ListBox x:Name="typeOfInstructionListBox_Wpf" 
                                Style="{StaticResource ListBoxStyle}" Height="120" Margin="0,0,0,20"/>

                        <!-- Date Selection -->
                        <TextBlock x:Name="label6_Wpf" Text="📅 Дата окончания:" 
                                  Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                        <DatePicker x:Name="datePickerEnd_Wpf" 
                                   Style="{StaticResource DatePickerStyle}" Margin="0,0,0,20"/>

                        <!-- Create Button -->
                        <Button x:Name="buttonCreateInstruction_Wpf" Content="📝 Создать инструктаж" 
                               Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,20"/>

                        <!-- People Selection -->
                        <TextBlock Text="👥 Выбор сотрудников:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                        <ListBox x:Name="checkedListBoxNamesOfPeopleCreatingInstr_Wpf" 
                                Style="{StaticResource ListBoxStyle}" Height="200" SelectionMode="Multiple"/>
                    </StackPanel>

                    <!-- Right Column: Instruction Text and Actions -->
                    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sync Button -->
                        <Button x:Name="SyncNamesWithDB_Wpf" Grid.Row="0" Content="👥 Синхронизировать имена с Базой Данных" 
                               Style="{StaticResource ButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>

                        <!-- Instruction Text -->
                        <GroupBox Grid.Row="1" Header="📝 Текст инструктажа" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,20">
                            <TextBox x:Name="InstructionTextBox_Wpf" 
                                    Style="{StaticResource TextBoxStyle}" Margin="0"
                                    TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>

                        <!-- For Drivers Checkbox -->
                        <CheckBox x:Name="checkBoxIsForDrivers_Wpf" Grid.Row="2" Content="🚗 Для водителей" 
                                 Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,20"/>

                        <!-- Submit Button -->
                        <Button x:Name="submitInstructionToPeople_Wpf" Grid.Row="3" Content="📤 Отправить выбранным людям инструктаж" 
                               Style="{StaticResource ExportButtonStyle}" HorizontalAlignment="Stretch" Height="50"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Контроль -->
            <TabItem Header="📊 Контроль" Style="{StaticResource TabItemStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <Button x:Name="TestButtonForInstructions_Wpf" Grid.Row="0" Content="🔄 Обновление" 
                           Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Width="200" Margin="0,0,0,20"/>

                    <!-- Main Content Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Side: Not Passed Instructions -->
                        <GroupBox Grid.Column="0" Header="❌ Не пройденные инструктажи" Style="{StaticResource GroupBoxStyle}" Margin="0,0,20,0">
                            <ListBox x:Name="listBoxOfNotPassedByInstructions_Wpf" 
                                    Style="{StaticResource ListBoxStyle}" Margin="0"/>
                        </GroupBox>

                        <!-- Right Side: DataGrids -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- People That Not Passed DataGrid -->
                            <GroupBox Grid.Row="0" Header="👥 Сотрудники, не прошедшие инструктаж" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,10">
                                <DataGrid x:Name="dataGridViewPeopleThatNotPassedInstr_Wpf" 
                                         Style="{StaticResource DataGridStyle}" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имена" Binding="{Binding Names}" Width="*"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Passed}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <!-- Passed Instructions DataGrid -->
                            <GroupBox Grid.Row="1" Header="✅ Пройденные инструктажи" Style="{StaticResource GroupBoxStyle}" Margin="0,10,0,0">
                                <DataGrid x:Name="dataGridViewPassedInstructions_Wpf" 
                                         Style="{StaticResource DataGridStyle}" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Инструктаж" Binding="{Binding Instruction}" Width="*"/>
                                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/>
                                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Формирование отчёта -->
            <TabItem Header="📄 Формирование отчёта" Style="{StaticResource TabItemStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Instructions -->
                    <TextBlock Grid.Row="0" x:Name="instructionReportLabel_Wpf" Text="📋 Выберите тип и причину инструктажа:" 
                              Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>

                    <!-- Help Text -->
                    <TextBlock Grid.Row="1" x:Name="helpReportLabel_Wpf" 
                              Text="💡 Выберите инструктаж и нажмите 'Экспортировать в Excel' для создания отчета о прохождении" 
                              TextWrapping="Wrap" Foreground="#4C566A" FontStyle="Italic" FontSize="12" Margin="0,0,0,20"/>

                    <!-- TreeView for Instruction Selection -->
                    <GroupBox Grid.Row="2" Header="📂 Инструктажи" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,20">
                        <TreeView x:Name="instructionReportTreeView_Wpf" 
                                 Style="{StaticResource TreeViewStyle}" Margin="0"/>
                    </GroupBox>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="refreshReportButton_Wpf" Content="🔄 Обновить" 
                               Style="{StaticResource ButtonStyle}" Width="150" Margin="0,0,15,0"/>
                        <Button x:Name="exportReportButton_Wpf" Content="📊 Экспортировать в Excel" 
                               Style="{StaticResource ActionButtonStyle}" Width="220"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 4: Прохождение инструктажей -->
            <TabItem Header="📖 Прохождение инструктажей" Style="{StaticResource TabItemStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Information Panel -->
                    <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                            Padding="20" Margin="0,0,0,20" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="📖 Просмотр и прохождение инструктажей" 
                                      FontSize="16" FontWeight="Bold" Foreground="#1976D2"/>
                            <TextBlock Text="В этом разделе вы можете просматривать назначенные инструктажи и отмечать их как пройденные." 
                                      FontSize="12" Foreground="#1976D2" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sync Button -->
                    <Button Grid.Row="1" x:Name="buttonSyncManualyInstrWithDB_Wpf" 
                           Content="🔄 Синхронизировать инструктажи с Базой Данных" 
                           Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Width="400" Margin="0,0,0,20"/>

                    <!-- Instructions List -->
                    <GroupBox Grid.Row="2" Header="📋 Список неплановых инструктажей" Style="{StaticResource GroupBoxStyle}">
                        <ListBox x:Name="ListOfUnplannedInstructions_Wpf" 
                                Style="{StaticResource ListBoxStyle}" Margin="0"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer with Tasks -->
        <Border Grid.Row="2" Background="#ECEFF4" Padding="10" BorderBrush="#D8DEE9" BorderThickness="0,1,0,0">
            <Grid Height="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tasks Label -->
                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LabelTray_Wpf" Text="📋 Список задач:" 
                          Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Left"/>

                <!-- Tasks List -->
                <ListBox Grid.Row="1" Grid.Column="0" x:Name="TrayOfTasksList_Wpf" 
                        Style="{StaticResource ListBoxStyle}" Margin="0,5,10,5"/>

                <!-- Task Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <Button x:Name="RefreshTasksButton_Wpf" Content="🔄 Обновить задачи" 
                           Style="{StaticResource ButtonStyle}" Width="200" Margin="0,0,0,10"/>
                    <Button x:Name="button1_Wpf" Content="✅ Задание выполнено" 
                           Style="{StaticResource ActionButtonStyle}" Width="200"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>