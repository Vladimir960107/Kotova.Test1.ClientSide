<Window x:Class="Kotova.Test1.ClientSide.ChiefWPF.ChiefWindowFresh"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Kotova.Test1.ClientSide.ChiefWPF"
        mc:Ignorable="d"
        Title="ChiefOfDepartment" Height="845" Width="1102"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Nordic Color Palette Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#81A1C1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#88C0D0"/>
            <Setter Property="BorderBrush" Value="#5E81AC"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#BF616A"/>
            <Setter Property="BorderBrush" Value="#D08770"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="BorderBrush" Value="#8FBCBB"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style x:Key="ListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="GridViewColumnHeader.Background" Value="#ECEFF4"/>
            <Setter Property="GridViewColumnHeader.BorderBrush" Value="#D8DEE9"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#ECEFF4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Missing styles for the Control tab -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D8DEE9"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D8DEE9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
        </Style>

        <!-- TreeView Style for better readability -->
        <Style x:Key="ModernTreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- TreeViewItem Style for better hover and selection effects -->
        <Style x:Key="ModernTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#2E3440"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="19" Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Expander button -->
                            <ToggleButton x:Name="Expander" 
                                        ClickMode="Press" 
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <!-- Content area with background -->
                            <Border x:Name="Bd" 
                                  Grid.Column="1" 
                                  Background="{TemplateBinding Background}" 
                                  BorderBrush="{TemplateBinding BorderBrush}" 
                                  BorderThickness="{TemplateBinding BorderThickness}" 
                                  Padding="{TemplateBinding Padding}"
                                  CornerRadius="2">
                                <ContentPresenter x:Name="PART_Header" 
                                                ContentSource="Header" 
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <!-- Children items -->
                            <ItemsPresenter x:Name="ItemsHost" 
                                          Grid.Row="1" 
                                          Grid.Column="1" 
                                          Grid.ColumnSpan="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Visibility" TargetName="ItemsHost" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" TargetName="Expander" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="Bd" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="#F0F8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Simple Expander Style for TreeView -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Height="16" Padding="5,5,5,5" Width="16">
                            <Path x:Name="ExpandPath" 
                                  Data="M0,0 L0,6 L6,0 z" 
                                  Fill="#2E3440" 
                                  Stroke="#2E3440">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="135" CenterX="3" CenterY="3"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="RenderTransform" TargetName="ExpandPath">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="3" CenterY="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Fill" TargetName="ExpandPath" Value="#5E81AC"/>
                                <Setter Property="Stroke" TargetName="ExpandPath" Value="#5E81AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#5E81AC" BorderBrush="#4C566A" BorderThickness="0,0,0,2">
            <Grid Height="60" Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👔" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Руководитель отдела" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="label10_Wpf" Text="Вы вошли как:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="usernameLabel_Wpf" Text="[Имя пользователя]" FontWeight="Bold" VerticalAlignment="Center" Foreground="#EBCB8B" FontSize="14"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Button x:Name="testButton_Wpf" Grid.Column="1" Content="🧪 Test" 
                        Style="{StaticResource ActionButtonStyle}" 
                        ToolTip="Тестовая функция" Click="testButton_Wpf_Click"/>

                <!-- Exit Button -->
                <Button x:Name="LogOutButton_Wpf" Grid.Column="2" Content="🚪 Выйти" 
                        Style="{StaticResource DangerButtonStyle}" 
                        ToolTip="Выйти из учётной записи" Click="LogOutButton_Wpf_Click"/>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="ChiefTabControl_Wpf" Grid.Row="1" Margin="12,10,12,10" Background="#F8F9FA" BorderThickness="0" SelectionChanged="ChiefTabControl_Wpf_SelectionChanged">

            <!-- Tab 1: Создание инструктажей -->
            <TabItem Header="📝 Создание инструктажа" Style="{StaticResource TabItemStyle}">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left Column: Instruction Creation Form -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,20,0">

                        <!-- Instruction Type -->
                        <TextBlock x:Name="label2_Wpf" Text="📋 Тип инструктажа:" 
                                  Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                        <ListBox x:Name="typeOfInstructionListBox_Wpf" 
                                Style="{StaticResource ListBoxStyle}" Height="120" Margin="0,0,0,20">
                            <ListBoxItem Content="Первичный"/>
                            <ListBoxItem Content="Повторный"/>
                            <ListBoxItem Content="Повторный (для водителей)"/>
                            <ListBoxItem Content="Целевой"/>
                        </ListBox>

                        <!-- Instruction Cause -->
                        <TextBlock x:Name="label6_Wpf" Text="📄 Причина инструктажа:" 
                                  Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                        <TextBox x:Name="InstructionTextBox_Wpf" 
                                Style="{StaticResource TextBoxStyle}" 
                                TextWrapping="Wrap"
                                Height="80" 
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,20"/>

                        <!-- End Date -->
                        <TextBlock x:Name="label7_Wpf" Text="📅 Дата окончания (включительно):" 
                                  Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                        <DatePicker x:Name="datePickerEnd_Wpf" 
                                   Style="{StaticResource DatePickerStyle}" 
                                   Margin="0,0,0,30"/>

                        <!-- Create Button -->
                        <Button x:Name="buttonCreateInstruction_Wpf" 
                               Content="✅ Внести новый инструктаж" 
                               Style="{StaticResource SuccessButtonStyle}" 
                               Width="300"
                               Height="40"
                               Click="buttonCreateInstruction_Wpf_Click"/>

                        <!-- Help Text -->
                        <TextBlock Text="💡 После создания инструктажа используйте кнопку 'Назначить инструктаж сотрудникам' для назначения сотрудникам и выбора нормативных инструкций." 
                                  Style="{StaticResource HeaderTextStyle}" 
                                  FontSize="12" Foreground="#1976D2" Margin="0,15,0,0" TextWrapping="Wrap"/>
                        <Button x:Name="btnClearForm_Wpf" Background="#FFFDE7"  Content="🧹 Очистить форму создания инструктажа" Margin="0,20,0,0"
                            Click="btnClearForm_Wpf_Click" Height="46"/>

                    </StackPanel>

                    <!-- Right Column: Instructions Management -->
                    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Instructions List Header -->
                        <TextBlock Grid.Row="0" Text="📋 Управление инструктажами" 
                                  Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,15"/>

                        <!-- Management Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="btnRefreshInstructions_Wpf" Content="🔄 Обновить" 
                                   Style="{StaticResource ButtonStyle}" Margin="5,0,5,0" Click="btnRefreshInstructions_Wpf_Click"/>
                            <Button x:Name="btnEditInstruction_Wpf" Content="✏️ Редактировать" 
                                   Style="{StaticResource ActionButtonStyle}" Margin="0,0,25,0" Click="btnEditInstruction_Wpf_Click"/>
                            <Button x:Name="btnDeleteInstruction_Wpf" Content="🗑️ Удалить" 
                                   Style="{StaticResource DangerButtonStyle}" Click="btnDeleteInstruction_Wpf_Click"/>
                        </StackPanel>

                        <!-- Instructions ListView -->
                        <ListView x:Name="instructionsListView_Wpf" Grid.Row="2" 
                                 Style="{StaticResource ListViewStyle}" SelectionChanged="instructionsListView_Wpf_SelectionChanged" Margin="5,5,5,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Тип" Width="120" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="Причина" Width="200" DisplayMemberBinding="{Binding Cause}"/>
                                    <GridViewColumn Header="Дата начала" Width="100" DisplayMemberBinding="{Binding StartDate}"/>
                                    <GridViewColumn Header="Дата окончания" Width="100" DisplayMemberBinding="{Binding EndDate}"/>
                                    <GridViewColumn Header="Статус назначения" Width="120" DisplayMemberBinding="{Binding AssignedStatus}"/>
                                    <GridViewColumn Header="Статус выполнения" Width="120" DisplayMemberBinding="{Binding CompletedStatus}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
                            <Button x:Name="assignInstructionToGroupsButton_Wpf" Content="👥 Назначить инструктаж сотрудникам" 
                                   Style="{StaticResource ActionButtonStyle}" Click="assignInstructionToGroupsButton_Wpf_Click" Height="51" Width="677"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- Tab 2: Контроль (Training Compliance) -->
            <TabItem Header="🔍 Контроль" Style="{StaticResource TabItemStyle}">

                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" 
                              Text="📊 Контроль прохождения инструктажей" 
                              Style="{StaticResource HeaderStyle}" 
                              Margin="0,0,0,20"/>
                    <Button x:Name="refreshDataButton_Wpf" Content="🔄 Обновить данные" 
       Style="{StaticResource ActionButtonStyle}" 
       Click="refreshDataButton_Wpf_Click" Grid.Column="1" Margin="50,0,50,10"/>

                    <!-- Left Column Top: Instructions Tree (Updated) -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                        <TextBlock Text="📋 Инструктажи:" Style="{StaticResource SubHeaderStyle}"/>
                        <TreeView x:Name="treeViewInstructions_Wpf" Height="200" 
             Style="{StaticResource ModernTreeViewStyle}"
             ItemContainerStyle="{StaticResource ModernTreeViewItemStyle}"
             SelectedItemChanged="treeViewInstructions_Wpf_SelectedItemChanged">
                        </TreeView>
                    </StackPanel>

                    <!-- Right Column Top: Not Passed Instructions -->
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="10,0,0,0">
                        <TextBlock Text="❌ Не прошедшие инструктаж:" Style="{StaticResource SubHeaderStyle}"/>
                        <DataGrid x:Name="dataGridViewPeopleThatNotPassedInstr_Wpf" Height="200"
                                 Style="{StaticResource ModernDataGridStyle}"
                                 AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" 
                           Height="1" Background="#4C566A" Margin="0,20"/>

                    <!-- Left Column Bottom: Passed Instructions Tree (Updated) -->
                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,20,10,0">
                        <TextBlock Text="📊 Пройденные инструктажи:" Style="{StaticResource SubHeaderStyle}"/>
                        <TreeView x:Name="treeViewPassedInstructions_Wpf" Height="200" 
             Style="{StaticResource ModernTreeViewStyle}"
             ItemContainerStyle="{StaticResource ModernTreeViewItemStyle}"
             SelectedItemChanged="treeViewPassedInstructions_Wpf_SelectedItemChanged">
                        </TreeView>
                    </StackPanel>

                    <!-- Right Column Bottom: Passed Instructions Details -->
                    <StackPanel Grid.Column="1" Grid.Row="3" Margin="10,20,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="✅ Прошедшие инструктаж:" Style="{StaticResource SubHeaderStyle}"/>

                            <DataGrid x:Name="dataGridViewPassedInstructions_Wpf" Grid.Row="1" Height="200"
                                     Style="{StaticResource ModernDataGridStyle}"
                                     AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Пройден" Binding="{Binding IsPassed}" Width="80"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DatePassed}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Control Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Отчеты о прохождении инструктажей -->
            <TabItem Header="📊 Отчеты о прохождении" Style="{StaticResource TabItemStyle}">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Left Column: Instructions TreeView -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Margin="0,0,20,0">

                        <!-- Header -->
                        <TextBlock Text="📋 Список инструктажей" 
                      Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,15"/>

                        <!-- TreeView for instruction reports -->
                        <TreeView x:Name="treeViewInstructionReports_Wpf" 
                     Height="400" 
                     Background="White"
                     BorderBrush="#D8DEE9" 
                     BorderThickness="1"
                     Padding="5"
                     Margin="0,0,0,15"
                     SelectedItemChanged="treeViewInstructionReports_Wpf_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}" 
                                  Foreground="{Binding TextColor}"
                                  FontWeight="{Binding FontWeight}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="refreshInstructionReports_Wpf" 
                       Content="🔄 Обновить" 
                       Style="{StaticResource ButtonStyle}" 
                       Margin="0,0,10,0"
                       Click="refreshInstructionReports_Wpf_Click"/>

                            <Button x:Name="exportButton_Wpf" 
                       Content="📊 Экспортировать отчет" 
                       Style="{StaticResource SuccessButtonStyle}" 
                       IsEnabled="False"
                       Click="exportButton_Wpf_Click"/>
                        </StackPanel>

                        <!-- Help Text -->
                        <TextBlock Text="Выберите конкретный инструктаж из списка и нажмите 'Экспортировать отчет' для создания Excel-файла с данными о прохождении."
                      Style="{StaticResource HeaderTextStyle}" 
                      FontSize="11" 
                      Foreground="#1976D2" 
                      Margin="0,10,0,0" 
                      TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Right Column: Instruction Details -->
                    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Details Header -->
                        <TextBlock Grid.Row="0" Text="📋 Детали инструктажа" 
                      Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,15"/>

                        <!-- Instruction Details Panel -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="instructionDetailsPanel_Wpf" Margin="10">

                                <!-- Basic Information -->
                                <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" 
                           CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="📝 Основная информация" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="instructionIdDetail_Wpf" Text="-" Margin="5,2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="instructionTypeDetail_Wpf" Text="-" Margin="5,2"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Причина:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="instructionCauseDetail_Wpf" Text="-" Margin="5,2" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата начала:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="instructionStartDateDetail_Wpf" Text="-" Margin="5,2"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата окончания:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="instructionEndDateDetail_Wpf" Text="-" Margin="5,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Progress Information -->
                                <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" 
                           CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="📊 Статистика прохождения" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Всего сотрудников:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="totalEmployeesDetail_Wpf" Text="-" Margin="5,2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Прошли:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="passedEmployeesDetail_Wpf" Text="-" Margin="5,2"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Процент выполнения:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="completionPercentageDetail_Wpf" Text="-" Margin="5,2"/>
                                        </Grid>

                                        <!-- Progress Bar -->
                                        <ProgressBar x:Name="completionProgressBar_Wpf" 
                                        Height="20" 
                                        Margin="0,10,0,0" 
                                        Minimum="0" 
                                        Maximum="100" 
                                        Value="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Employee List -->
                                <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" 
                           CornerRadius="5" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="👥 Список сотрудников" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                        <ListView x:Name="employeeDetailsListView_Wpf" 
                                     Height="300" 
                                     Style="{StaticResource ListViewStyle}" RenderTransformOrigin="0.5,0.5">
                                            <ListView.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform/>
                                                    <SkewTransform AngleX="-0.252"/>
                                                    <RotateTransform/>
                                                    <TranslateTransform X="-0.661"/>
                                                </TransformGroup>
                                            </ListView.RenderTransform>
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="ФИО" Width="200" DisplayMemberBinding="{Binding FullName}"/>
                                                    <GridViewColumn Header="Должность" Width="150" DisplayMemberBinding="{Binding Position}"/>
                                                    <GridViewColumn Header="Статус" Width="100" DisplayMemberBinding="{Binding StatusText}"/>
                                                    <GridViewColumn Header="Дата прохождения" Width="120" DisplayMemberBinding="{Binding DatePassedText}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- Additional tabs would go here -->



        </TabControl>

        <!-- Footer with Tasks -->
        <Border Grid.Row="2" Background="#ECEFF4" Padding="10" BorderBrush="#D8DEE9" BorderThickness="0,1,0,0">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tasks Label -->
                <TextBlock Grid.Column="0" x:Name="LabelTray_Wpf" Text="📋 Статус: Готов к работе" 
                          Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center"/>

                <!-- Action Button -->
                <Button Grid.Column="1" x:Name="RefreshButton_Wpf" Content="🔄 Обновить" 
                       Style="{StaticResource ButtonStyle}" VerticalAlignment="Center" Click="RefreshButton_Wpf_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>