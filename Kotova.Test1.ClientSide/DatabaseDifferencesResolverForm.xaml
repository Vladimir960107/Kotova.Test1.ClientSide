<Window x:Class="Kotova.Test1.ClientSide.DatabaseDifferencesResolverForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разрешение различий в базах данных" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#ECEFF4">

    <Window.Resources>
        <!-- Enhanced Styles -->
        <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SubHeaderTextStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="TextBox" x:Key="DataTextBoxStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="TextBox" x:Key="DifferentFieldStyle" BasedOn="{StaticResource DataTextBoxStyle}">
            <Setter Property="Background" Value="#FFE5E5"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#21618C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SyncButtonStyle" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox" x:Key="DatabaseGroupBoxStyle">
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="FieldCheckBoxStyle">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Color Legend Style -->
        <Style TargetType="Border" x:Key="LegendItemStyle">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Enhanced Design -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <StackPanel>
                <TextBlock x:Name="EmployeeNameHeader" Style="{StaticResource HeaderTextStyle}" 
                           Foreground="White" FontSize="18"/>
                <TextBlock x:Name="PersonnelNumberHeader" Style="{StaticResource SubHeaderTextStyle}" 
                           Foreground="#BDC3C7" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Status and Color Legend -->
        <Border Grid.Row="1" Background="#ECF0F1" Padding="15,10" BorderBrush="#BDC3C7" BorderThickness="0,1">
            <StackPanel>
                <!-- Status Information -->
                <TextBlock x:Name="DifferencesTextBlock" FontSize="12" FontWeight="SemiBold" 
                           Margin="0,0,0,8" Foreground="#2C3E50"/>

                <!-- Color Legend -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Статусы:" FontWeight="SemiBold" Margin="0,0,15,0" VerticalAlignment="Center"/>

                    <Border Style="{StaticResource LegendItemStyle}" Background="#FADBD8" BorderBrush="#E74C3C">
                        <TextBlock Text="🔴 Различия" FontSize="10" Foreground="#E74C3C"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Lynks Database Data -->
                <GroupBox Grid.Column="0" Header="📊 База данных Lynks" Style="{StaticResource DatabaseGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="ФИО:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="LynksFullNameTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Отдел:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="LynksDepartmentTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Должность:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="LynksPositionTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Email:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="LynksEmailTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Табельный номер:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="LynksPersonnelNumberTextBox" Style="{StaticResource DataTextBoxStyle}"/>
                    </StackPanel>
                </GroupBox>

                <!-- TransElectro Database Data -->
                <GroupBox Grid.Column="1" Header="🏢 База данных TransElectro" Style="{StaticResource DatabaseGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="ФИО:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="TransElectroFullNameTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Отдел:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="TransElectroDepartmentTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Должность:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="TransElectroPositionTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Email:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="TransElectroEmailTextBox" Style="{StaticResource DataTextBoxStyle}"/>

                        <TextBlock Text="Табельный номер:" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBox x:Name="TransElectroPersonnelNumberTextBox" Style="{StaticResource DataTextBoxStyle}"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- Synchronization Controls -->
        <Border Grid.Row="3" Background="#F8F9FA" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Fields Selection -->
                <GroupBox Grid.Column="0" Header="Поля для синхронизации" Margin="0,0,10,0">
                    <StackPanel x:Name="FieldCheckBoxesPanel" Orientation="Horizontal" FlowDirection="LeftToRight">
                        <!-- CheckBoxes will be added dynamically -->
                    </StackPanel>
                </GroupBox>

                <!-- Sync Direction -->
                <GroupBox Grid.Column="1" Header="Направление синхронизации">
                    <ComboBox x:Name="SyncDirectionComboBox" Margin="5">
                        <ComboBoxItem Content="TransElectro → Lynks" Tag="ToLynks" IsSelected="True"/>
                    </ComboBox>
                </GroupBox>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="4" Background="#ECEFF4" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="🔄 Обновить данные" 
                        Style="{StaticResource ActionButtonStyle}" Click="RefreshButton_Click"/>

                <Button x:Name="SynchronizeButton" Content="🔄 Синхронизировать" 
                        Style="{StaticResource SyncButtonStyle}" Click="SynchronizeButton_Click"/>

                <Button Content="❌ Закрыть" Style="{StaticResource CancelButtonStyle}" 
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>