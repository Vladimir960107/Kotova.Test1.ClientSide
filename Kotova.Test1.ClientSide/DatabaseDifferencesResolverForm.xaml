<Window x:Class="Kotova.Test1.ClientSide.DatabaseDifferencesResolverForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 Разрешение различий в базах данных" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Styles -->
        <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="Foreground" Value="#34495E"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ReadOnlyTextBoxStyle">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="DifferentFieldStyle" BasedOn="{StaticResource ReadOnlyTextBoxStyle}">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#21618C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SyncButtonStyle" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox" x:Key="DatabaseGroupBoxStyle">
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="FieldCheckBoxStyle">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <StackPanel>
                <TextBlock x:Name="EmployeeNameHeader" 
                          Text="Разрешение различий для: [Имя сотрудника]"
                          Style="{StaticResource HeaderTextStyle}"
                          Foreground="White"
                          FontSize="18"/>
                <TextBlock x:Name="PersonnelNumberHeader" 
                          Text="Табельный номер: [Номер]"
                          Foreground="#BDC3C7"
                          FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LynksDatabase Data (Left Side) -->
            <GroupBox Grid.Column="0" Header="📊 LynksDatabase (Основная БД)" Style="{StaticResource DatabaseGroupBoxStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ФИО:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LynksFullNameTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Отдел:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LynksDepartmentTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Должность:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LynksPositionTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Email:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LynksEmailTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Табельный номер:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LynksPersonnelNumberTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- TransElectroProject Database Data (Right Side) -->
            <GroupBox Grid.Column="1" Header="🏢 ТрансэлектропроектDatabase" Style="{StaticResource DatabaseGroupBoxStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ФИО:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TransElectroFullNameTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Отдел:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TransElectroDepartmentTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Должность:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TransElectroPositionTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Email:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TransElectroEmailTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <TextBlock Text="Табельный номер:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TransElectroPersonnelNumberTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}"/>

                        <!-- Show message if employee not found -->
                        <TextBlock x:Name="NotFoundMessageTextBlock" 
                                  Text="❌ Сотрудник не найден в ТрансэлектропроектDatabase"
                                  Foreground="#E74C3C"
                                  FontWeight="Bold"
                                  FontSize="14"
                                  Margin="0,20,0,0"
                                  Visibility="Collapsed"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- Differences Section -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="15" Margin="10,0">
            <StackPanel>
                <TextBlock Text="🔍 Обнаруженные различия:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>
                <TextBlock x:Name="DifferencesTextBlock" 
                          Text="Различия не обнаружены"
                          FontSize="12"
                          Foreground="#27AE60"
                          FontWeight="SemiBold"/>

                <!-- Synchronization Options -->
                <Grid x:Name="SyncOptionsGrid" Visibility="Collapsed" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Синхронизировать поля:" 
                              Style="{StaticResource FieldLabelStyle}" 
                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="FieldCheckBoxesPanel"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ComboBox x:Name="SyncDirectionComboBox" Width="200" Margin="10,0">
                            <ComboBoxItem Content="📊 Из LynksDB → ТрансэлектропроектDB" Tag="ToTransElectro"/>
                            <ComboBoxItem Content="🏢 Из ТрансэлектропроектDB → LynksDB" Tag="ToLynks" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#34495E" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" 
                       Content="🔄 Обновить данные" 
                       Style="{StaticResource ActionButtonStyle}"
                       Click="RefreshButton_Click"/>

                <Button x:Name="SynchronizeButton" 
                       Content="🔄 Синхронизировать" 
                       Style="{StaticResource SyncButtonStyle}"
                       Click="SynchronizeButton_Click"
                       Visibility="Collapsed"/>

                <Button x:Name="CloseButton" 
                       Content="❌ Закрыть" 
                       Style="{StaticResource CancelButtonStyle}"
                       Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>