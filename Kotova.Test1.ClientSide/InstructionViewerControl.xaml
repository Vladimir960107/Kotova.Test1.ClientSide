<UserControl x:Class="Kotova.Test1.ClientSide.ManagementWPF.Views.InstructionViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Kotova.Test1.ClientSide.ManagementWPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Shared Styles -->
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Content Area -->
    <TabControl x:Name="InstructionTabControl" Background="Transparent">

        <!-- Not Passed Instructions Tab -->
        <TabItem Header="📋 Непройденные инструктажи" Style="{StaticResource TabItemStyle}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Лист непройденных инструктажей" 
                   Style="{StaticResource HeaderTextStyle}" FontSize="16"/>

                <!-- Main Content Grid -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Side - Instructions List -->
                    <GroupBox Grid.Column="0" Header="Список инструктажей" Style="{StaticResource GroupBoxStyle}">
                        <ListBox x:Name="InstructionsListBox" 
                         Style="{StaticResource ListBoxStyle}"
                         ItemsSource="{Binding Instructions}"
                         SelectedItem="{Binding SelectedInstruction}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D8DEE9" BorderThickness="0,0,0,1" Padding="8">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="Medium"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <!-- Right Side - Normative Instructions -->
                    <GroupBox Grid.Column="1" Header="Нормативные документы" Style="{StaticResource GroupBoxStyle}">
                        <ListBox x:Name="NormativeInstructionsListBox" 
                         Style="{StaticResource ListBoxStyle}"
                         ItemsSource="{Binding NormativeInstructions}"
                         MouseDoubleClick="NormativeInstructionsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D8DEE9" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Url}" Foreground="Blue" 
                                               TextDecorations="Underline" Cursor="Hand" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>

                <!-- Bottom Section - Pass Instruction (only visible when allowed) -->
                <Border Grid.Row="2" Background="#A3BE8C" CornerRadius="5" Margin="0,10,0,0" Padding="15"
                        Visibility="{Binding AllowCompletion, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <CheckBox x:Name="PassInstructionCheckBox" 
                          Content="✅ Подтверждаю, что инструктаж пройден"
                          Style="{StaticResource CheckBoxStyle}"
                          IsEnabled="{Binding IsInstructionSelected}"
                          IsChecked="{Binding IsInstructionPassed}"
                          Foreground="White"
                          FontSize="14"
                          Command="{Binding PassInstructionCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Passed Instructions Tab -->
        <TabItem Header="✅ Пройденные инструктажи" Style="{StaticResource TabItemStyle}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Лист пройденных инструктажей" 
                   Style="{StaticResource HeaderTextStyle}" FontSize="16"/>

                <!-- Content Grid -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Passed Instructions DataGrid -->
                    <GroupBox Grid.Column="0" Header="История пройденных инструктажей" Style="{StaticResource GroupBoxStyle}">
                        <DataGrid x:Name="PassedInstructionsDataGrid" 
                          Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding PassedInstructions}"
                          SelectedItem="{Binding SelectedPassedInstruction}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="📅 Дата инструктажа" Binding="{Binding DatePassed}" Width="140"/>
                                <DataGridTextColumn Header="📋 Тип инструктажа" Binding="{Binding Type}" Width="160"/>
                                <DataGridTextColumn Header="📝 Причина инструктажа" Binding="{Binding Cause}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Related Files List -->
                    <GroupBox Grid.Column="1" Header="Связанные документы" Style="{StaticResource GroupBoxStyle}">
                        <ListBox x:Name="RelatedFilesListBox" 
                         Style="{StaticResource ListBoxStyle}"
                         ItemsSource="{Binding RelatedFiles}"
                         MouseDoubleClick="RelatedFilesListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D8DEE9" BorderThickness="0,0,0,1" Padding="8">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="Blue" 
                                           TextDecorations="Underline"
                                           Cursor="Hand"
                                           FontWeight="Medium"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>