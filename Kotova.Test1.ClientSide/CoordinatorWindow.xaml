<Window x:Class="Kotova.Test1.ClientSide.ChiefWPF.ChiefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kotova.Test1.ClientSide.ChiefWPF"
        mc:Ignorable="d"
        Title="Руководитель отдела - Система управления инструктажами" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Button Styles -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <!-- ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- TreeView Style -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1976D2" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and User Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="👔 Панель руководителя" 
                              FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Вы вошли как:" 
                              FontSize="12" Foreground="White" 
                              Margin="30,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UsernameLabel" Text="[Имя пользователя]" 
                              FontSize="12" FontWeight="Bold" Foreground="#FFEB3B" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Button Grid.Column="1" x:Name="RefreshButton" Content="🔄 Обновить" 
                        Background="#4CAF50" Margin="10,0"/>

                <Button Grid.Column="2" x:Name="LogOutButton" Content="🚪 Выйти" 
                        Background="#F44336" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" x:Name="ChiefTabControl" 
                    Background="#F5F5F5" BorderThickness="0" Margin="0">

            <!-- Tab 1: Создание инструктажей (Instruction Creation) -->
            <TabItem Header="📝 Создание инструктажей" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10">
                        <Button x:Name="SyncNamesWithDB" Content="👥 Синхронизировать имена с БД" MinWidth="200" Margin="0,0,10,0"/>
                        <CheckBox x:Name="CheckBoxIsForDrivers" Content="Для водителей" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Main Content Grid -->
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Side: People Selection -->
                        <GroupBox Grid.Column="0" Header="👥 Выбор сотрудников" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="CheckedListBoxNamesOfPeopleCreatingInstr" 
                                         SelectionMode="Multiple"/>
                            </Grid>
                        </GroupBox>

                        <!-- Right Side: Instruction Details -->
                        <GroupBox Grid.Column="1" Header="📋 Детали инструктажа">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Instruction Type -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Тип инструктажа:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ListBox x:Name="TypeOfInstructionListBox" Height="80" SelectionMode="Single"/>
                                </StackPanel>

                                <!-- Date Selection -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Дата окончания:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <DatePicker x:Name="DatePickerEnd" Width="150"/>
                                </StackPanel>

                                <!-- Instruction Text -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                    <TextBlock Text="Текст инструктажа:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="InstructionTextBox" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="150"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="ButtonCreateInstruction" Content="📝 Создать инструктаж" 
                                            Background="#4CAF50" Margin="0,0,10,0"/>
                                    <Button x:Name="SubmitInstructionToPeople" Content="📤 Отправить инструктаж" 
                                            Background="#FF9800"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Контроль (Training Compliance) -->
            <TabItem Header="📊 Контроль" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10">
                        <Button x:Name="TestButtonForInstructions" Content="📋 Обновление" MinWidth="150"/>
                    </StackPanel>

                    <!-- Main Content Grid -->
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Side: Not Passed Instructions -->
                        <GroupBox Grid.Column="0" Header="❌ Не пройденные инструктажи" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="ListBoxOfNotPassedByInstructions" Grid.Row="0" Height="150" Margin="0,0,0,10"/>

                                <DataGrid x:Name="DataGridViewPeopleThatNotPassedInstr" Grid.Row="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя сотрудника" Binding="{Binding Names}" Width="200"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Passed}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- Right Side: Passed Instructions -->
                        <GroupBox Grid.Column="1" Header="✅ Пройденные инструктажи" Margin="5,0,0,0">
                            <DataGrid x:Name="DataGridViewPassedInstructions">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Инструктаж" Binding="{Binding InstructionName}" Width="200"/>
                                    <DataGridTextColumn Header="Дата прохождения" Binding="{Binding DatePassed}" Width="120"/>
                                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Формирование отчёта (Report Generation) -->
            <TabItem Header="📄 Формирование отчёта" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Instructions -->
                    <TextBlock Grid.Row="0" x:Name="InstructionReportLabel" 
                              Text="Выберите тип и причину инструктажа:" 
                              FontSize="14" FontWeight="SemiBold" Margin="0,10"/>

                    <!-- Help Text -->
                    <TextBlock Grid.Row="1" x:Name="HelpReportLabel" 
                              Text="Выберите инструктаж и нажмите 'Экспортировать в Excel' для создания отчета о прохождении" 
                              FontSize="12" Foreground="#666" Margin="0,5,0,15" TextWrapping="Wrap"/>

                    <!-- Tree View for Instruction Selection -->
                    <TreeView Grid.Row="2" x:Name="InstructionReportTreeView" Margin="0,0,0,10">
                        <!-- TreeView items will be populated programmatically -->
                    </TreeView>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="RefreshReportButton" Content="🔄 Обновить список" Margin="0,0,10,0"/>
                        <Button x:Name="ExportReportButton" Content="📊 Экспортировать в Excel" Background="#4CAF50"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 4: Прохождение инструктажей (Instruction Passing) -->
            <TabItem Header="📖 Прохождение инструктажей" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Information Panel -->
                    <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                            Padding="15" Margin="0,10,0,20" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="📖 Просмотр и прохождение инструктажей" 
                                      FontSize="16" FontWeight="Bold" Foreground="#1976D2"/>
                            <TextBlock Text="В этом разделе вы можете просматривать назначенные инструктажи и отмечать их как пройденные." 
                                      FontSize="12" Foreground="#1976D2" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sync Button -->
                    <Button Grid.Row="1" x:Name="ButtonSyncManuallyInstrWithDB" 
                            Content="🔄 Синхронизировать инструктажи с Базой Данных" 
                            MinWidth="350" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                    <!-- Instructions List -->
                    <GroupBox Grid.Row="2" Header="📋 Список неплановых инструктажей">
                        <ListBox x:Name="ListOfUnplannedInstructions" Margin="5">
                            <!-- Items will be populated programmatically -->
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#E0E0E0" Padding="10" BorderBrush="#BDBDBD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tasks Label -->
                <TextBlock Grid.Column="0" x:Name="LabelTray" Text="📋 Список задач:" 
                          VerticalAlignment="Center" FontWeight="SemiBold"/>

                <!-- Tasks List -->
                <ListBox Grid.Column="1" x:Name="TrayOfTasksList" Height="80" Margin="10,0" 
                         Background="White" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                <!-- Refresh Tasks Button -->
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Button x:Name="RefreshTasksButton" Content="🔄 Обновить задачи" 
                            Background="#FF9800" MinWidth="150" Margin="0,0,0,5"/>
                    <Button x:Name="CompleteTaskButton" Content="✅ Задание выполнено" 
                            Background="#4CAF50" MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>