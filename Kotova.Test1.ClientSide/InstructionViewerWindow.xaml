<Window x:Class="Kotova.Test1.ClientSide.InstructionViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kotova.Test1.ClientSide.InstructionControlWPF"
        Title="Система управления инструктажами" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- App-level button styles -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#81A1C1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#EBCB8B"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="#BF616A"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header Bar -->
            <RowDefinition Height="*"/>     <!-- Main Content (InstructionViewerControl) -->
            <RowDefinition Height="Auto"/>  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Header Bar with App-Level Controls -->
        <Border Grid.Row="0" Background="#5E81AC" BorderBrush="#4C566A" BorderThickness="0,0,0,2">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Вы вошли как:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UsernameTextBlock" Text="{Binding UserName}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#EBCB8B" FontSize="14"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Button x:Name="RefreshButton" Grid.Column="1" Content="🔄 Обновить" 
                        Style="{StaticResource RefreshButtonStyle}" 
                        Click="RefreshButton_Click"
                        ToolTip="Обновить список инструктажей"/>

                <!-- Settings Button -->
                <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙️" 
                        Style="{StaticResource SettingsButtonStyle}" 
                        Click="SettingsButton_Click"
                        ToolTip="Дополнительные настройки"/>

                <!-- Exit Button -->
                <Button x:Name="ExitButton" Grid.Column="3" Content="❌" 
                        Style="{StaticResource ExitButtonStyle}" 
                        Click="ExitButton_Click"
                        ToolTip="Закрыть приложение"/>
            </Grid>
        </Border>

        <!-- Main Content Area - InstructionViewerControl -->
        <controls:InstructionViewerControl Grid.Row="1" 
                                           x:Name="InstructionViewerControl"
                                           DataContext="{Binding InstructionViewModel}"
                                        JwtToken="{Binding JwtToken}"
                                        UserName="{Binding UserName}"
                                        IsChief="{Binding IsChief}"
                                        AllowCompletion="{Binding AllowCompletion}"/>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#4C566A" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           VerticalAlignment="Center" 
                           Margin="10,0"
                           Foreground="White"/>

                <TextBlock x:Name="VersionTextBlock" Grid.Column="1" 
                           Text="{Binding Version}" 
                           VerticalAlignment="Center" 
                           Margin="10,0"
                           Foreground="#D8DEE9"/>
            </Grid>
        </Border>
    </Grid>
</Window>