<Window x:Class="Kotova.Test1.ClientSide.InstructionViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр инструктажей" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Border.BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Border.BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="Border.BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Border.BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with username and settings -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,5">
                    <TextBlock Text="Вы вошли как:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="UsernameTextBlock" Text="Unknown" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить" 
                        Style="{StaticResource ButtonStyle}" Click="RefreshButton_Click"/>

                <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙️" 
                        Style="{StaticResource ButtonStyle}" Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <TabControl x:Name="InstructionTabControl" Grid.Row="1">
            <!-- Not Passed Instructions Tab -->
            <TabItem Header="Непройденные инструктажи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Лист непройденных инструктажей:" 
                               Style="{StaticResource HeaderTextStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Instructions List -->
                        <ListBox x:Name="InstructionsListBox" Grid.Column="0" 
                                 Style="{StaticResource ListBoxStyle}"
                                 SelectionChanged="InstructionsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Normative Instructions List -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Нормативные документы:" 
                                       Style="{StaticResource HeaderTextStyle}"/>

                            <ListBox x:Name="NormativeInstructionsListBox" Grid.Row="1" 
                                     Style="{StaticResource ListBoxStyle}"
                                     SelectionMode="Multiple">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}" 
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Tag="{Binding}"
                                                  Checked="NormativeInstruction_Checked"
                                                  Unchecked="NormativeInstruction_Unchecked"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <CheckBox x:Name="PassInstructionCheckBox" Grid.Row="2" 
                              Content="Подтверждаю, что инструктаж пройден"
                              Style="{StaticResource CheckBoxStyle}"
                              IsEnabled="False"
                              Checked="PassInstructionCheckBox_Checked"/>
                </Grid>
            </TabItem>

            <!-- Passed Instructions Tab -->
            <TabItem Header="Пройденные инструктажи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Лист пройденных инструктажей:" 
                               Style="{StaticResource HeaderTextStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Passed Instructions DataGrid -->
                        <DataGrid x:Name="PassedInstructionsDataGrid" Grid.Column="0" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="PassedInstructionsDataGrid_SelectionChanged"
                                  Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата инструктажа" Binding="{Binding DatePassed}" Width="120"/>
                                <DataGridTextColumn Header="Тип инструктажа" Binding="{Binding Type}" Width="150"/>
                                <DataGridTextColumn Header="Причина инструктажа" Binding="{Binding Cause}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Related Files List -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Связанные документы:" 
                                       Style="{StaticResource HeaderTextStyle}"/>

                            <ListBox x:Name="RelatedFilesListBox" Grid.Row="1" 
                                     Style="{StaticResource ListBoxStyle}"
                                     MouseDoubleClick="RelatedFilesListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="Blue" 
                                                   TextDecorations="Underline"
                                                   Cursor="Hand"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>