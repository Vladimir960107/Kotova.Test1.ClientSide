<Window x:Class="Kotova.Test1.ClientSide.InstructionViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления инструктажами" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#81A1C1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#434C5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#A3BE8C"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#EBCB8B"/>
            <Setter Property="Foreground" Value="#2E3440"/>
        </Style>

        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#ECEFF4"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#ECEFF4"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E9F0"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#ECEFF4"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#5E81AC" BorderBrush="#4C566A" BorderThickness="0,0,0,2">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Вы вошли как:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UsernameTextBlock" Text="Unknown" FontWeight="Bold" VerticalAlignment="Center" Foreground="#EBCB8B" FontSize="14"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Button x:Name="RefreshButton" Grid.Column="1" Content="🔄 Обновить" 
                        Style="{StaticResource RefreshButtonStyle}" Click="RefreshButton_Click"
                        ToolTip="Обновить список инструктажей"/>

                <!-- Settings Button with Enhanced Styling -->
                <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙️" 
                        Style="{StaticResource SettingsButtonStyle}" Click="SettingsButton_Click"
                        ToolTip="Дополнительные настройки"/>

                <!-- Exit Button -->
                <Button x:Name="ExitButton" Grid.Column="3" Content="❌" 
                        Style="{StaticResource SettingsButtonStyle}" Click="ExitButton_Click"
                        ToolTip="Закрыть приложение"
                        Background="#BF616A"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <TabControl x:Name="InstructionTabControl" Grid.Row="1" Background="Transparent">

            <!-- Not Passed Instructions Tab -->
            <TabItem Header="📋 Непройденные инструктажи" Style="{StaticResource TabItemStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Лист непройденных инструктажей" 
                               Style="{StaticResource HeaderTextStyle}" FontSize="16"/>

                    <!-- Main Content Grid -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Side - Instructions List -->
                        <GroupBox Grid.Column="0" Header="Список инструктажей" Style="{StaticResource GroupBoxStyle}">
                            <ListBox x:Name="InstructionsListBox" 
                                     Style="{StaticResource ListBoxStyle}"
                                     SelectionChanged="InstructionsListBox_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#D8DEE9" BorderThickness="0,0,0,1" Padding="8">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                        <!-- Right Side - Normative Instructions -->
                        <GroupBox Grid.Column="1" Header="Нормативные документы" Style="{StaticResource GroupBoxStyle}">
                            <ListBox x:Name="NormativeInstructionsListBox" 
                                     Style="{StaticResource ListBoxStyle}"
                                     MouseDoubleClick="NormativeInstructionsListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#D8DEE9" BorderThickness="0,0,0,1" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Url}" Foreground="Blue" 
                                                           TextDecorations="Underline" Cursor="Hand" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>

                    <!-- Bottom Section - Pass Instruction -->
                    <Border Grid.Row="2" Background="#A3BE8C" CornerRadius="5" Margin="0,10,0,0" Padding="15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <CheckBox x:Name="PassInstructionCheckBox" 
                                      Content="✅ Подтверждаю, что инструктаж пройден"
                                      Style="{StaticResource CheckBoxStyle}"
                                      IsEnabled="False"
                                      Foreground="White"
                                      FontSize="14"
                                      Checked="PassInstructionCheckBox_Checked"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Passed Instructions Tab -->
            <TabItem Header="✅ Пройденные инструктажи" Style="{StaticResource TabItemStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Лист пройденных инструктажей" 
                               Style="{StaticResource HeaderTextStyle}" FontSize="16"/>

                    <!-- Content Grid -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Passed Instructions DataGrid -->
                        <GroupBox Grid.Column="0" Header="История пройденных инструктажей" Style="{StaticResource GroupBoxStyle}">
                            <DataGrid x:Name="PassedInstructionsDataGrid" 
                                      Style="{StaticResource DataGridStyle}"
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="PassedInstructionsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="📅 Дата инструктажа" Binding="{Binding DatePassed}" Width="140"/>
                                    <DataGridTextColumn Header="📋 Тип инструктажа" Binding="{Binding Type}" Width="160"/>
                                    <DataGridTextColumn Header="📝 Причина инструктажа" Binding="{Binding Cause}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Related Files List -->
                        <GroupBox Grid.Column="1" Header="Связанные документы" Style="{StaticResource GroupBoxStyle}">
                            <ListBox x:Name="RelatedFilesListBox" 
                                     Style="{StaticResource ListBoxStyle}"
                                     MouseDoubleClick="RelatedFilesListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#D8DEE9" BorderThickness="0,0,0,1" Padding="8">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       Foreground="Blue" 
                                                       TextDecorations="Underline"
                                                       Cursor="Hand"
                                                       FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Management Tab (For Chiefs) -->
            <TabItem x:Name="ManagementTab" Header="🏢 Управление" Style="{StaticResource TabItemStyle}" Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Панель управления инструктажами" 
                               Style="{StaticResource HeaderTextStyle}" FontSize="16"/>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Employee Management -->
                        <GroupBox Grid.Column="0" Header="Управление сотрудниками" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Button Content="📊 Назначить инструктаж" Style="{StaticResource ButtonStyle}" 
                                        Click="AssignInstructionButton_Click" Margin="5"/>
                                <Button Content="👥 Просмотр сотрудников" Style="{StaticResource ButtonStyle}" 
                                        Click="ViewEmployeesButton_Click" Margin="5"/>
                                <Button Content="📈 Отчеты" Style="{StaticResource ButtonStyle}" 
                                        Click="ReportsButton_Click" Margin="5"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- System Management -->
                        <GroupBox Grid.Column="1" Header="Системные функции" Style="{StaticResource GroupBoxStyle}">
                            <StackPanel>
                                <Button Content="🔄 Синхронизация данных" Style="{StaticResource ButtonStyle}" 
                                        Click="SyncDataButton_Click" Margin="5"/>
                                <Button Content="⚙️ Настройки системы" Style="{StaticResource ButtonStyle}" 
                                        Click="SystemSettingsButton_Click" Margin="5"/>
                                <Button Content="🗂️ Управление документами" Style="{StaticResource ButtonStyle}" 
                                        Click="DocumentManagementButton_Click" Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#4C566A" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" 
                           Text="Готов к работе" 
                           VerticalAlignment="Center" 
                           Margin="10,0"
                           Foreground="White"/>

                <TextBlock x:Name="VersionTextBlock" Grid.Column="1" 
                           Text="v1.0.0" 
                           VerticalAlignment="Center" 
                           Margin="10,0"
                           Foreground="#D8DEE9"/>
            </Grid>
        </Border>
    </Grid>
</Window>