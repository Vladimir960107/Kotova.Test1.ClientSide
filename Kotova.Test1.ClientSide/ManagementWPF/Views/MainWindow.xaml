<Window x:Class="Kotova.Test1.ClientSide.ManagementWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Kotova.Test1.ClientSide.ManagementWPF.Views"
        Title="Система управления инструктажами - Главный инженер" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyboardNavigation.TabNavigation="Local">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with User Info and Sign Out -->
        <Border Grid.Row="0" Background="#1976D2" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side - Title and User -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Система управления инструктажами" 
                              FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding CurrentUser}" 
                              FontSize="14" Foreground="White" 
                              Margin="20,0,0,0"/>
                </StackPanel>

                <!-- Right side - Sign Out Button -->
                <Button Grid.Column="1" 
                        Content="🚪 Выйти из аккаунта" 
                        Command="{Binding SignOutCommand}"
                        Background="#F44336" 
                        Foreground="White"
                        BorderThickness="0"
                        Padding="10,5"
                        Margin="10,0,0,0"
                        ToolTip="Выйти из учётной записи"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="0">
            <TabItem Header="🚨 Внеплановые инструктажи для начальников отделов">
                <views:UnplannedInstructionView DataContext="{Binding UnplannedInstructionViewModel}" />
            </TabItem>

            <TabItem Header="📊 Отчёты" IsEnabled="False">
                <TextBlock Text="Будет реализовано позже" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontSize="16" 
                          Foreground="Gray"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Время последнего обновления: " Foreground="Gray"/>
                    <TextBlock Text="{Binding LastUpdateTime}" Foreground="Gray"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>