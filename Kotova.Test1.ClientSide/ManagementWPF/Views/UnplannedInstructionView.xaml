<UserControl x:Class="Kotova.Test1.ClientSide.ManagementWPF.Views.UnplannedInstructionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Kotova.Test1.ClientSide.ManagementWPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15">
            <StackPanel>
                <TextBlock Text="Управление внеплановыми инструктажами для начальников" 
                          FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" 
                          FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Create Instruction -->
                <GroupBox Grid.Column="0" Header="Создание нового инструктажа">
                    <StackPanel>
                        <!-- Chiefs Selection -->
                        <Label Content="Выберите начальников и заместителей:" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding ChiefsSelection}" 
                                Height="200" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" 
                                             Content="{Binding DisplayText}"
                                             Margin="5,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Instruction Details -->
                        <Label Content="Причина инструктажа:" FontWeight="Bold" Margin="0,15,0,5"/>
                        <TextBox Text="{Binding InstructionCause, UpdateSourceTrigger=PropertyChanged}" 
                                Height="60" 
                                TextWrapping="Wrap" 
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"/>

                        <Label Content="Дата окончания:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <DatePicker SelectedDate="{Binding EndDate}" 
                                   HorizontalAlignment="Left"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Обновить данные" 
                                   Command="{Binding LoadDataCommand}"
                                   IsEnabled="{Binding IsNotLoading}"/>
                            <Button Content="Назначить инструктаж" 
                                   Command="{Binding AssignInstructionCommand}"
                                   Background="#4CAF50" 
                                   Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Right Panel - Status Monitoring -->
                <GroupBox Grid.Column="1" Header="Статус назначенных инструктажей">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="Обновить статус" 
                               Command="{Binding RefreshStatusCommand}"
                               HorizontalAlignment="Right"/>

                        <ListView Grid.Row="1" ItemsSource="{Binding InstructionStatuses}"
                                 Margin="0,10,0,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Инструктаж" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CauseOfInstruction}" 
                                                          TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Дата создания" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BeginDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Прогресс" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                                <Binding Path="TotalPassed"/>
                                                                <Binding Path="TotalAssigned"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <ProgressBar Value="{Binding TotalPassed}" 
                                                               Maximum="{Binding TotalAssigned}" 
                                                               Height="10"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>

                            <!-- Detailed view for selected instruction -->
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding CauseOfInstruction}">
                                        <ListView ItemsSource="{Binding ChiefStatuses}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding ChiefName}" Width="120"/>
                                                    <GridViewColumn Header="Отдел" DisplayMemberBinding="{Binding DepartmentName}" Width="100"/>
                                                    <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding JobPosition}" Width="120"/>
                                                    <GridViewColumn Header="Статус" Width="80">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding IsPassed, Converter={StaticResource BoolToStatusConverter}}"
                                                                          Foreground="{Binding IsPassed, Converter={StaticResource BoolToColorConverter}}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Дата прохождения" Width="100">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DatePassed, StringFormat={}{0:dd.MM.yyyy}}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" 
               Background="Black" 
               Opacity="0.5" 
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <StackPanel Grid.Row="0" Grid.RowSpan="3" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
            <TextBlock Text="Загрузка..." 
                      Foreground="White" 
                      HorizontalAlignment="Center" 
                      Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>